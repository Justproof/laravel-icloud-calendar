{
  "name": "justproof/laravel-icloud-calendar",
  "description": "Read busy time from, and write events to, iCloud calendars over CalDAV from a Laravel app. App-specific password in, free slots and invites out.",
  "keywords": [
    "laravel",
    "icloud",
    "caldav",
    "calendar",
    "booking",
    "ics",
    "scheduling"
  ],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Justproof",
      "homepage": "https://pcdrama.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "nesbot/carbon": "^2.72|^3.0",
    "sabre/vobject": "^4.5"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "Justproof\\IcloudCalendar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Justproof\\IcloudCalendar\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Justproof\\IcloudCalendar\\IcloudCalendarServiceProvider"
      ],
      "aliases": {
        "IcloudCalendar": "Justproof\\IcloudCalendar\\Facades\\IcloudCalendar"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
